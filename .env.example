# Salin sebagai .env. Jangan commit nilai rahasia.
DATABASE_URL=postgres://opsmind:opsmind@localhost:5432/opsmind?sslmode=disable
PORT=8080
APP_ORIGIN=http://localhost:8080
OPERATOR_USERNAME=operator
# Isi password minimal 12 karakter; PASSWORD_HASH bcrypt lebih diutamakan.
OPERATOR_PASSWORD=
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=false
MODEL_MODE=meta
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
BUDGET_PHASE=development
CREDIT_LIMIT_USD=20
DEVELOPMENT_LIMIT_USD=15
DEMO_LIMIT_USD=5
RUN_LIMIT_USD=0.25
MAX_MODEL_ROUNDS=8
MAX_TOOL_CALLS=16
RUN_TIMEOUT_SECONDS=180
MODEL_TIMEOUT_SECONDS=30
MAX_TRANSIENT_RETRIES=2
OT_VARIANCE_BPS=2000
PRODUCTION_SHORTFALL_BPS=1000
DOWNTIME_THRESHOLD_MINUTES=60
ATTENDANCE_GRACE_MINUTES=15
SEED_IF_EMPTY=false
WEB_DIR=web/dist
